{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Toy",
            "type": "debugpy",
            "request": "launch",
            "module": "src.experiments.toy",
            "args": []
        },
        {
            "name": "Clustering: MNIST",
            "type": "debugpy",
            "request": "launch",
            "module": "src.experiments.clustering",
            "args": [
                "-cn", "experiments/clustering/mnist",
            ]
        },
        {
            "name": "Clustering: FashionMNIST",
            "type": "debugpy",
            "request": "launch",
            "module": "src.experiments.clustering",
            "args": [
                "-cn", "experiments/clustering/fashion_mnist",
            ]
        },
        {
            "name": "OpenProblems: DKD",
            "type": "debugpy",
            "request": "launch",
            "module": "src.experiments.scRNA",
            "args": [
                "-cn", "experiments/scRNA/open_problems",
                "data/scRNA@data=dkd",
                "model.encode_covariates=true",
                "model.u_initial_strategy=stratified_data",
                "priors@model.prior_params=crypt/dp_vampprior_unleashed",
            ]
        },
    ]
}
